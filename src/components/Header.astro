---
import { navLinks, profile } from '../data/content.js';
import ExternalLink from './ExternalLink.astro';

interface Props {
  currentPath?: string;
  compact?: boolean;
}

const { currentPath = '/', compact = false } = Astro.props;
const isCurrent = (href: string) => href === '/explore/'
  ? currentPath === href || currentPath.startsWith('/explore/')
  : currentPath === href;
---

<header class:list={["site-header", { "compact-header": compact }]}>
  <nav class="nav shell" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="Vinicius Santana home" data-nav-link>
      <span class="brand-mark" aria-hidden="true">VS</span>
      {!compact && <span>{profile.name}</span>}
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="primary-navigation-menu"
      data-menu-toggle
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <div class="nav-panel" id="primary-navigation-menu" data-open="false" data-nav-panel>
      <ul class="nav-links">
        {navLinks.filter(link => !compact || link.href !== '/resume/').map((link) => (
          <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined} data-nav-link>{link.label}</a></li>
        ))}
      </ul>
      {!compact && <div class="nav-actions">
        <ExternalLink class="button button-ghost" href={profile.github} ariaLabel="View Vinicius Santana on GitHub">
          View GitHub
        </ExternalLink>
        <a class="button button-small" href="/#contact">Contact me</a>
      </div>}
    </div>
    {compact && <a class="header-resume" href="/resume/" aria-current={isCurrent('/resume/') ? 'page' : undefined}>Resume</a>}
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const mobileNavigation = window.matchMedia('(max-width: 820px)');

  const setMenuOpen = (isOpen: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
    panel.dataset.open = String(isOpen);
    document.body.classList.toggle('nav-open', isOpen);
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-nav-link], [data-nav-panel] a').forEach((link) => {
    link.addEventListener('click', (event) => {
      setMenuOpen(false);
      if (event.detail !== 0) return;

      const destination = new URL(link.href);
      const isCurrentDocument = destination.origin === window.location.origin && destination.pathname === window.location.pathname;
      const target = isCurrentDocument && destination.hash
        ? document.querySelector<HTMLElement>(destination.hash)
        : null;

      if (target) requestAnimationFrame(() => target.focus());
    });
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      toggle.focus();
    }
  });

  mobileNavigation.addEventListener('change', (event) => {
    if (!event.matches) setMenuOpen(false);
  });
</script>
