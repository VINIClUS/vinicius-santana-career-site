---
import ResponsivePoster from './ResponsivePoster.astro';
import { workPosters } from '../content/scenes';
import type { CollectionEntry } from 'astro:content';

interface Props {
  caseStudy?: CollectionEntry<'caseStudies'>['data'];
  domain?: boolean;
  legacyAnchors?: {
    primary: string;
    aliases: string[];
  };
}

const { caseStudy, legacyAnchors, domain = false } = Astro.props;
if (!domain && !caseStudy) throw new Error('A project card requires a case study');
const title = domain ? 'Health Systems' : caseStudy!.title;
const summary = domain ? 'Public-health data and software in an operational setting.' : caseStudy!.summary;
const technologies = domain ? ['Public Health', 'Integration'] : caseStudy!.technologies;
const poster = workPosters[domain ? 'public-health' : caseStudy!.id];
const href = domain ? '/#experience' : `/work/${caseStudy!.id}/`;
---

<article class="project-card visual-work-card" id={legacyAnchors?.primary}>
  {legacyAnchors?.aliases.map((alias) => <span class="legacy-anchor" id={alias} aria-hidden="true"></span>)}
  <ResponsivePoster poster={poster} />
  <div class="work-card-copy">
    <p class="project-eyebrow">{domain ? 'Experience · Domain' : caseStudy!.eyebrow}</p>
    <h3>{title}</h3>
    <p>{summary}</p>
    <ul class="tech-list" aria-label={`${title} technologies`}>
      {technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <div class="project-actions"><a class="text-link" href={href}>{domain ? 'View experience' : 'View project'}</a></div>
  </div>
</article>
<style>
  .visual-work-card { padding: 0; overflow: hidden; background: #0c151d; border: 1px solid var(--line); border-radius: 6px; box-shadow: none; }
  .work-card-copy { display: flex; flex-direction: column; flex: 1; padding: 20px; }
  .work-card-copy h3 { font-size: 1.2rem; line-height: 1.25; letter-spacing: -.025em; }
  .work-card-copy > p:not(.project-eyebrow) { font-size: .88rem; color: var(--muted); }
  .project-eyebrow { font-size: .65rem; }
  .tech-list { gap: 6px; }
  .tech-list li { padding: 5px 7px; border-radius: 3px; font-size: .7rem; background: #23333f; }
  .project-actions { margin-top: 22px; }
</style>
