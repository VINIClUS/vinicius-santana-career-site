---
import { createInitialInfraState, transitionInfrastructure, infraNodeIds } from './simulation/infrastructure.ts';
const initial = createInitialInfraState();
const transcript = transitionInfrastructure(initial, { type: 'FAIL_NODE', nodeId: 'node-02' });
---
<section class="walkthrough infrastructure-simulation" data-infrastructure-simulation aria-labelledby="infra-title">
  <p class="eyebrow">Synthetic simulation · Illustrative</p>
  <h2 id="infra-title">Infrastructure failover</h2>
  <p>Explore a synthetic three-node cluster. Fail node-02 to transfer its workload to node-01 while the shared layer stays available.</p>
  <div class="infra-layout">
    <div class="infra-scheme" data-infra-scheme data-workload-node={initial.workloadNodeId} aria-label="Illustrative three-node cluster scheme">
      <p class="scheme-label">Three-node workload cluster</p>
      <ol class="scheme-nodes" aria-label="Cluster nodes">
        {infraNodeIds.map(id => <li data-infra-scheme-node={id} data-status={initial.nodes[id]}><strong>{id}</strong><span> {initial.nodes[id]}</span></li>)}
      </ol>
      <div class="scheme-workload" data-infra-scheme-workload>Workload assigned to {initial.workloadNodeId}</div>
      <div class="scheme-shared" data-infra-scheme-shared>Shared layer: {initial.sharedLayer}</div>
    </div>
    <div class="walkthrough-state">
      <h3>Cluster state</h3>
      <ul class="infra-nodes">{infraNodeIds.map(id => <li data-infra-node={id}>{id}: {initial.nodes[id]}</li>)}</ul>
      <p data-infra-workload>Workload: {initial.workloadNodeId}</p>
      <p data-infra-shared>Shared layer: {initial.sharedLayer}</p>
      <div class="walkthrough-controls">
        <button class="button button-primary" type="button" data-fail-node disabled>Fail node-02</button>
        <button class="button button-secondary" type="button" data-infra-reset disabled>Reset simulation</button>
      </div>
      <p data-infra-help>Interactive controls require JavaScript. The scenario transcript is available below.</p>
      <p role="status" aria-live="polite" aria-atomic="true" data-infra-announcement>Ready. Three nodes online; workload on node-02.</p>
      <h3>Timeline</h3>
      <ol data-infra-timeline></ol>
    </div>
  </div>
  <details class="transcripts" open>
    <summary>Scenario transcript</summary>
    <p>Initial state: node-01, node-02 and node-03 online; workload on node-02; shared layer available.</p>
    <ol>{transcript.timeline.map(event => <li>{event.description}</li>)}</ol>
    <p>Reset restores all three nodes online, returns the workload to node-02 and clears the timeline.</p>
  </details>
</section>
<style>
  .infra-layout { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .infra-scheme { display: grid; gap: 16px; padding: 20px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-soft); }
  .scheme-label { margin: 0; color: var(--muted-strong); font-size: .82rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .scheme-nodes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding: 0; margin: 0; list-style: none; }
  .scheme-nodes li { display: grid; gap: 6px; padding: 14px; border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: 8px; background: var(--surface); font-size: .85rem; }
  .scheme-nodes li[data-status="failed"] { border-color: #ff8585; color: #ffaaaa; }
  .scheme-workload, .scheme-shared { padding: 12px; border-radius: 6px; background: var(--surface); color: var(--muted-strong); font-size: .85rem; }
  .scheme-shared { border-left: 3px solid var(--accent); }
  .infra-nodes { display: grid; gap: 12px; }
  [data-infra-node] { padding: 8px 12px; border-left: 3px solid var(--accent); }
  [data-infra-node][data-status="failed"] { border-color: #ff8585; color: #ffaaaa; }
  summary { cursor: pointer; padding-block: 12px; font-weight: 600; }
  summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 800px) { .infra-layout, .scheme-nodes { grid-template-columns: 1fr; } }
</style>
