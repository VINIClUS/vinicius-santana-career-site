---
import type { CollectionEntry } from 'astro:content';
import SystemViewCards from './SystemViewCards.astro';
import { projectDefinitions } from './projects.ts';
import { graphLabel } from './system-view.ts';

interface Props { caseStudy: CollectionEntry<'caseStudies'>['data']; }
const { caseStudy } = Astro.props;
const { relations } = projectDefinitions.limnopulse;
const componentFor = (id: string) => caseStudy.architecture.find(component => component.id === id)!;
const bands = [
  { title: 'Observations', ids: ['mqtt-ingestion'] },
  { title: 'Telemetry', ids: ['telemetry-api', 'evaluator'] },
  { title: 'Events', ids: ['alert-rules', 'notifications'] },
];
const boundaries = ['cloud-infrastructure', 'production-device-layer'];
---
<div class="integrated-system-view limnopulse-system-view" data-integrated-system-view>
  <p class="explorer-note">Conceptual operational map, not live telemetry. It traces observation, telemetry, and event responsibilities across local and external boundaries without representing a real environment.</p>
  <div class="system-view-layout">
    <section class="system-graph limnopulse-graph" data-system-graph aria-labelledby="system-map-title">
      <div class="graph-heading"><h3 id="system-map-title">Operational map</h3><p>Observations move through telemetry and event bands, with operational boundaries framing the flow.</p></div>
      <ol class="boundary-nodes" aria-label="Operational boundaries">
        {boundaries.map(id => { const component = componentFor(id); return <li class="graph-node boundary-node"><a href={`#component-${id}`} data-component-link={id}><span class="graph-node-kicker" aria-hidden="true">Boundary</span><strong>{component.title}</strong><span class="selection-marker" aria-hidden="true">Selected</span></a></li>; })}
      </ol>
      <div class="operational-bands">
        {bands.map(band => <section class="system-band" aria-label={`${band.title} band`}><h4>{band.title}</h4><ol>{band.ids.map(id => { const component = componentFor(id); return <li class="graph-node"><a href={`#component-${id}`} data-component-link={id}><span class="graph-node-kicker" aria-hidden="true">{band.title}</span><strong>{component.title}</strong><span class="selection-marker" aria-hidden="true">Selected</span></a></li>; })}</ol></section>)}
      </div>
      <ol class="graph-connectors" aria-label="Limnopulse relationships">
        {relations.map(relation => <li data-graph-connector data-relation-from={relation.from} data-relation-to={relation.to}><svg viewBox="0 0 36 16" aria-hidden="true"><path d="M2 8h27m-7-5 7 5-7 5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg><span class="graph-connector-label">{graphLabel(relation)}</span></li>)}
      </ol>
    </section>
    <SystemViewCards components={caseStudy.architecture} relations={relations} />
  </div>
</div>
<style>
  .limnopulse-system-view { min-width: 0; }
  .system-view-layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(280px, 2fr); gap: 24px; align-items: start; margin-top: 24px; }
  .system-graph { min-width: 0; border: 1px solid var(--line); border-radius: 12px; background: linear-gradient(140deg, rgba(141,202,255,.1), rgba(7,18,31,.35)); padding: 20px; overflow: hidden; }
  .graph-heading h3 { margin: 0; }.graph-heading p { margin: 8px 0 0; color: var(--muted-strong); font-size: .8rem; line-height: 1.5; }
  .boundary-nodes, .system-band ol, .graph-connectors { margin: 0; padding: 0; list-style: none; }
  .boundary-nodes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 18px; }
  .operational-bands { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 12px 0; }
  .system-band { min-width: 0; border-top: 3px solid #8dcaff; background: rgba(141,202,255,.04); padding: 12px; }.system-band h4 { margin: 0 0 10px; color: #8dcaff; font-size: .78rem; }
  .system-band ol { display: grid; gap: 10px; }
  .graph-node { min-width: 0; }.graph-node a { display: flex; flex-direction: column; gap: 6px; min-height: 82px; padding: 12px; border: 1px solid var(--line-strong); border-radius: 8px; background: rgba(4,14,25,.6); color: var(--text); }
  .boundary-node a { border-style: dashed; }.graph-node-kicker { color: #8dcaff; font-size: .61rem; letter-spacing: .08em; text-transform: uppercase; }.graph-node strong { font-size: .77rem; line-height: 1.25; }
  .selection-marker { display: none; margin-top: auto; color: #8dcaff; font-size: .65rem; }.graph-node a[aria-current="true"] { border: 2px solid #8dcaff; }.graph-node a[aria-current="true"] .selection-marker { display: block; }
  .graph-connectors { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }.graph-connectors li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 7px; align-items: start; border-left: 2px solid #8dcaff; background: rgba(255,255,255,.025); padding: 8px; color: var(--muted-strong); font-size: .69rem; line-height: 1.35; }.graph-connectors svg { width: 28px; margin-top: 2px; color: #8dcaff; }
  a:focus-visible { outline: 3px solid #8dcaff; outline-offset: 4px; }
  @media (max-width: 760px) { .system-view-layout { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .boundary-nodes, .operational-bands, .graph-connectors { grid-template-columns: 1fr; } }
</style>
