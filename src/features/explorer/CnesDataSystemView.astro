---
import type { CollectionEntry } from 'astro:content';
import ResponsivePoster from '../../components/ResponsivePoster.astro';
import { details } from '../../content/scenes';
import SystemViewCards from './SystemViewCards.astro';
import SystemGraphConnectors from './SystemGraphConnectors.astro';
import { projectDefinitions } from './projects.ts';

interface Props { caseStudy: CollectionEntry<'caseStudies'>['data']; }
const { caseStudy } = Astro.props;
const { relations } = projectDefinitions.cnesdata;
const componentFor = (id: string) => caseStudy.architecture.find(component => component.id === id)!;
const graphNodes = [
  { id: 'canonical-contracts', x: 16, y: 16 }, { id: 'edge-agent', x: 16, y: 46 }, { id: 'web-dashboard', x: 16, y: 78 },
  { id: 'central-api', x: 50, y: 50 },
  { id: 'tenant-isolation', x: 84, y: 26 }, { id: 'parquet-to-gold', x: 84, y: 55 }, { id: 'kubernetes', x: 84, y: 82 },
];
---
<div class="integrated-system-view cnesdata-system-view" data-integrated-system-view>
  <p class="explorer-note">Conceptual architecture map for public discussion. Connections describe system responsibilities rather than a live deployment; processing and deployment boundaries remain illustrative.</p>
  <div class="system-view-layout">
    <div class="system-graph-column">
      <section class="system-graph cnesdata-graph" data-system-graph aria-labelledby="system-map-title">
        <div class="graph-heading"><h3 id="system-map-title">System map</h3><p>Central API is the branching hub between contracts, clients, and downstream boundaries.</p></div>
        <div class="graph-stage">
          <SystemGraphConnectors components={caseStudy.architecture} nodes={graphNodes} relations={relations} />
          <ol class="graph-nodes" aria-label="CnesData system components">
          {graphNodes.map(node => { const component = componentFor(node.id); return <li id={`graph-node-${node.id}`} data-graph-node={node.id} class={node.id === 'central-api' ? 'graph-node graph-node-hub' : 'graph-node'} style={`--node-x: ${node.x}%; --node-y: ${node.y}%`}>
            <a href={`#component-${node.id}`} data-component-link={node.id}>
              <span class="graph-node-kicker" aria-hidden="true">{node.id === 'central-api' ? 'Hub' : 'Component'}</span>
              <strong>{component.title}</strong>
              <span class="selection-marker" aria-hidden="true">Selected</span>
            </a>
          </li>; })}
          </ol>
        </div>
      </section>
      <figure class="system-poster">
        <ResponsivePoster poster={details.cnesdata.poster} />
        <figcaption>CnesData / detailed architectural maquette · static, illustrative poster.</figcaption>
      </figure>
    </div>
    <SystemViewCards components={caseStudy.architecture} relations={relations} />
  </div>
</div>
<style>
  .cnesdata-system-view { min-width: 0; }
  .system-view-layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(280px, 2fr); gap: 24px; align-items: start; margin-top: 24px; }
  .system-graph-column { display: grid; gap: 20px; min-width: 0; }
  .system-graph { min-width: 0; border: 1px solid var(--line); border-radius: 12px; background: linear-gradient(140deg, rgba(132,244,230,.08), rgba(7,18,31,.35)); padding: 20px; overflow: hidden; }
  .graph-heading h3 { margin: 0; }
  .graph-heading p { margin: 8px 0 0; color: var(--muted-strong); font-size: .8rem; line-height: 1.5; }
  .graph-stage { --graph-connector: var(--accent); position: relative; height: 440px; margin-top: 20px; }
  .graph-nodes { position: absolute; inset: 0; z-index: 2; margin: 0; padding: 0; list-style: none; }
  .graph-node { position: absolute; left: var(--node-x); top: var(--node-y); width: 29%; min-width: 0; transform: translate(-50%, -50%); }
  .graph-node a { display: flex; flex-direction: column; gap: 6px; min-height: 74px; padding: 12px; border: 1px solid var(--line-strong); border-radius: 8px; background: rgba(4,14,25,.92); color: var(--text); }
  .graph-node-hub a { border-color: var(--accent); box-shadow: inset 0 0 0 1px rgba(132,244,230,.25); }
  .graph-node-kicker { color: var(--accent); font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; }
  .graph-node strong { font-size: .8rem; line-height: 1.25; }
  .selection-marker { display: none; margin-top: auto; color: var(--accent); font-size: .65rem; }
  .graph-node a[aria-current="true"] { border: 2px solid var(--accent); }
  .graph-node a[aria-current="true"] .selection-marker { display: block; }
  .system-poster { overflow: hidden; margin: 0; border: 1px solid var(--line); border-radius: 12px; background: #080f19; }
  .system-poster :global(picture), .system-poster :global(img) { display: block; }
  .system-poster :global(img) { height: auto; object-fit: contain; }
  .system-poster figcaption { padding: 14px; border-top: 1px solid var(--line); color: var(--muted-strong); font-size: .72rem; }
  a:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 760px) { .system-view-layout { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .graph-stage { height: 470px; } .graph-node { width: 30%; } }
</style>
