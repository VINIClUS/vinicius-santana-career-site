---
import type { CollectionEntry } from 'astro:content';
import SystemViewCards from './SystemViewCards.astro';
import SystemGraphConnectors from './SystemGraphConnectors.astro';
import { projectDefinitions } from './projects.ts';

interface Props { caseStudy: CollectionEntry<'caseStudies'>['data']; }
const { caseStudy } = Astro.props;
const { relations } = projectDefinitions.infrastructure;
const componentFor = (id: string) => caseStudy.architecture.find(component => component.id === id)!;
const sources = ['image-builds', 'ansible-contracts', 'operations-automation'];
const topology = 'reference-topology';
const graphNodes = [
  { id: 'image-builds', x: 20, y: 20 }, { id: 'ansible-contracts', x: 20, y: 50 }, { id: 'operations-automation', x: 20, y: 80 },
  { id: topology, x: 78, y: 50, halfHeight: 16.12 },
];
const routes = {
  'image-builds→reference-topology': { label: { x: 49, y: 35 } },
  'ansible-contracts→reference-topology': { label: { x: 49, y: 50 } },
  'operations-automation→reference-topology': { label: { x: 49, y: 65 } },
};
---
<div class="integrated-system-view infrastructure-system-view" data-integrated-system-view>
  <p class="explorer-note">Conceptual reference topology, not a production inventory or a map of any real environment. Connectors describe responsibilities converging on a shared topology rather than an active deployment.</p>
  <div class="system-view-layout">
    <section class="system-graph infrastructure-graph" data-system-graph aria-labelledby="system-map-title">
      <div class="graph-heading"><h3 id="system-map-title">Reference topology map</h3><p>Three source capabilities converge on one reference topology.</p></div>
      <div class="graph-stage">
        <SystemGraphConnectors components={caseStudy.architecture} nodes={graphNodes} relations={relations} nodeHalfWidth={15.5} nodeHalfHeight={13.34} {routes} />
        <ol class="graph-nodes" aria-label="Infrastructure system components">
          {graphNodes.map(node => { const component = componentFor(node.id); return <li id={`graph-node-${node.id}`} data-graph-node={node.id} class={node.id === topology ? 'graph-node graph-node-hub' : 'graph-node'} style={`--node-x: ${node.x}%; --node-y: ${node.y}%`}><a href={`#component-${node.id}`} data-component-link={node.id}><span class="graph-node-kicker" aria-hidden="true">{sources.includes(node.id) ? 'Source' : 'Convergence'}</span><strong>{component.title}</strong><span class="selection-marker" aria-hidden="true">Selected</span></a></li>; })}
        </ol>
      </div>
    </section>
    <SystemViewCards components={caseStudy.architecture} relations={relations} />
  </div>
</div>
<style>
  .infrastructure-system-view { --graph-accent: #c4b8f7; --graph-connector: #c4b8f7; --graph-node-width: 31%; --graph-node-height: 96px; }
  .system-graph { background: linear-gradient(140deg, rgba(196,184,247,.1), rgba(7,18,31,.35)); }
  .graph-stage { position: relative; height: 360px; margin-top: 20px; }
  .graph-node-hub a { height: 116px; justify-content: center; }
</style>
