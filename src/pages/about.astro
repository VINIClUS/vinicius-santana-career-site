---
import ExternalLink from '../components/ExternalLink.astro';
import PracticeCards from '../components/PracticeCards.astro';
import StackGrid from '../components/StackGrid.astro';
import { experience, profile } from '../data/content.js';
import EditorialLayout from '../layouts/EditorialLayout.astro';
---

<EditorialLayout
  title="About — Vinicius Santana"
  description="About Vinicius Santana, a Python backend engineer building data-intensive APIs, validation services and automation for municipal public-health systems."
  canonicalPath="/about/"
  currentPath="/about/"
  observatory
>
  <header class="page-hero shell about-hero">
    <div class="about-hero-copy">
      <p class="eyebrow">About</p>
      <h1>Python backend engineering grounded in operational reality.</h1>
      <p class="summary">
        I design and operate data-intensive APIs, validation services and automation for municipal public-health systems.
        My work combines FastAPI, SQLAlchemy and PostgreSQL with tenant-aware authorization, automated tests and monitored
        Linux deployments.
      </p>
    </div>
    <figure class="about-portrait">
      <picture>
        <source srcset="/assets/images/vinicius-about.avif" type="image/avif" />
        <source srcset="/assets/images/vinicius-about.webp" type="image/webp" />
        <img src="/assets/images/vinicius-about.jpg" alt="Professional portrait of Vinicius Santana" width="900" height="1125" decoding="async" />
      </picture>
      <figcaption>{profile.title} · {profile.location}</figcaption>
    </figure>
  </header>

  <section class="section section-muted" aria-labelledby="experience-heading">
    <div class="shell experience-grid">
      <div class="section-heading">
        <p class="eyebrow">Experience</p>
        <h2 id="experience-heading">Experience across software, data, infrastructure and operations.</h2>
        <p>{experience.summary}</p>
      </div>
      <div class="experience-roles">
        {experience.roles.map((role) => (
          <article class="timeline-card">
            <div class="timeline-meta"><span>{role.period}</span><span>{role.organization}</span></div>
            <h3>{role.role}</h3>
            <ul class="check-list">{role.highlights.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="approach-heading">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">How I work</p>
        <h2 id="approach-heading">Make contracts explicit, protect boundaries and design for recovery.</h2>
        <p>
          I work from the operational problem backward: define typed contracts and exception paths, protect tenant
          boundaries, test deterministic rules, and keep deployment, observability, backup and rollback procedures close
          to the code. The result is software that teams can inspect, recover and maintain.
        </p>
      </div>
      <PracticeCards />
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="stack-heading">
    <div class="shell">
      <div class="section-heading"><p class="eyebrow">Stack</p><h2 id="stack-heading">Tools chosen in context.</h2></div>
      <StackGrid />
    </div>
  </section>

  <section class="section contact-section" aria-labelledby="about-contact-title">
    <div class="shell contact-card">
      <div><p class="eyebrow">Next step</p><h2 id="about-contact-title">Start with the work or start a conversation.</h2></div>
      <div class="contact-actions">
        <a class="button" href="/explore/">View selected work</a>
        <a class="button button-secondary" href={profile.mailto}>Email me</a>
        <ExternalLink class="button button-ghost" href={profile.linkedin} ariaLabel="Open Vinicius Santana on LinkedIn">LinkedIn</ExternalLink>
      </div>
    </div>
  </section>
</EditorialLayout>
