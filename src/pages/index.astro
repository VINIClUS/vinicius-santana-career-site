---
import ExternalLink from '../components/ExternalLink.astro';
import PracticeCards from '../components/PracticeCards.astro';
import ResponsivePoster from '../components/ResponsivePoster.astro';
import { overview } from '../content/scenes';
import StackGrid from '../components/StackGrid.astro';
import { experience, profile } from '../data/content.js';
import EditorialLayout from '../layouts/EditorialLayout.astro';

const legacyAnchors = ['case-cnesdata', 'case-aquafarm', 'case-esus-pec-bootstrap', 'case-infra-ansible', 'case-packer-proxmox-templates'];
---

<EditorialLayout currentPath="/" observatory>
  <section class="observatory-hero section" id="top" aria-labelledby="hero-title">
    <div class="shell observatory-hero-grid">
      <div class="hero-content">
        <p class="eyebrow">Building better systems</p>
        <h1 id="hero-title">Vinicius<br />Santana</h1>
        <p class="hero-role">Software &amp; Data Engineer</p>
        <p class="hero-positioning">I build reliable systems where software, data and infrastructure meet.</p>
        <ul class="domain-pillars" aria-label="Engineering domains">
          <li><span aria-hidden="true">◫</span>Data Systems</li>
          <li><span aria-hidden="true">⌘</span>Distributed Infrastructure</li>
          <li><span aria-hidden="true">▤</span>Backend Engineering</li>
          <li><span aria-hidden="true">♧</span>Public Health</li>
        </ul>
        <div id="projects" class="atlas-introduction" aria-labelledby="projects-title">
          {legacyAnchors.map(id => <span id={id} class="atlas-legacy-anchor" aria-hidden="true"></span>)}
          <p class="eyebrow" id="projects-title">Systems Atlas</p>
          <p>Explore the systems, engineering decisions and evidence behind my work.</p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button" href="/explore/">Explore my work <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <p class="hero-location">{profile.location} · Software, data &amp; operations</p>
      </div>
      <figure class="home-atlas-preview" data-home-preview data-preview-state="poster">
        <div class="home-atlas-stage">
          <ResponsivePoster poster={overview.poster} priority />
          <div data-preview-host aria-hidden="true"></div>
        </div>
        <figcaption><strong>CnesData · LimnoPulse · Infrastructure</strong><br />
          Three systems. A conceptual map of the work, not a live network.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section contact-section" id="contact" aria-labelledby="contact-title" tabindex="-1">
    <div class="shell contact-card">
      <div>
        <p class="eyebrow">Resume &amp; contact</p>
        <h2 id="contact-title">A quick path to the practical details.</h2>
        <p>I’m open to remote Software Engineering, Data Engineering and platform-focused conversations.</p>
      </div>
      <div class="contact-actions" aria-label="Resume and contact links">
        <a class="button" href={profile.mailto}>Email {profile.email}</a>
        <a class="button button-secondary" href="/resume/">View resume</a>
        <a class="button button-ghost" href={profile.resume} download>Download resume PDF</a>
        <ExternalLink class="button button-ghost" href={profile.linkedin} ariaLabel="Open Vinicius Santana on LinkedIn">
          LinkedIn
        </ExternalLink>
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div class="about-copy">
        <p class="eyebrow">About</p>
        <h2 id="about-title">I work where data quality, backend systems and operations meet.</h2>
        <p>
          I’m Vinicius Santana, a software and data engineer based in Brazil. I replace fragile manual routines with
          observable, repeatable software and documentation that keeps the operational context visible.
        </p>
        <p><a class="text-link" href="/about/">More about my experience and working style</a></p>
      </div>
      <PracticeCards />
    </div>
  </section>

  <section class="section section-muted" id="experience" aria-labelledby="experience-title">
    <div class="shell experience-grid">
      <div class="section-heading sticky-heading">
        <p class="eyebrow">Experience</p>
        <h2 id="experience-title">Public-health data and software in an operational setting.</h2>
        <p>{experience.summary}</p>
      </div>
      <article class="timeline-card">
        <div class="timeline-meta"><span>{experience.period}</span><span>{experience.organization}</span></div>
        <h3>{experience.role}</h3>
        <ul class="check-list">{experience.highlights.map((item) => <li>{item}</li>)}</ul>
      </article>
    </div>
  </section>

  <section class="section" id="stack" aria-labelledby="stack-title">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Stack</p>
        <h2 id="stack-title">Tools used across backend, data and operations work.</h2>
      </div>
      <StackGrid />
    </div>
  </section>
</EditorialLayout>

<script>
  import '../features/explorer/home-preview-client';
</script>

<style>
  .atlas-introduction { position: relative; scroll-margin-top: 100px; }
  .atlas-introduction .eyebrow { margin-bottom: 8px; }
  .atlas-introduction > p:not(.eyebrow) { color: var(--muted); max-width: 430px; font-size: .9rem; }
  .atlas-legacy-anchor { position: absolute; top: 0; scroll-margin-top: 100px; }
  .home-atlas-preview { margin: 0; min-width: 0; width: 100%; }
  .home-atlas-stage { position: relative; aspect-ratio: 4 / 5; background: #050a11; overflow: hidden; border-radius: 8px; }
  .home-atlas-stage :global(picture), .home-atlas-stage :global(img), [data-preview-host] {
    position: absolute; inset: 0; display: block; width: 100%; height: 100%;
  }
  [data-preview-host] { pointer-events: none; }
  [data-preview-host] :global(canvas) { display: block; width: 100%; height: 100%; pointer-events: none; }
  .home-atlas-stage :global(picture) { z-index: 1; }
  [data-preview-state="ready"] :global(picture) { visibility: hidden; }
  .home-atlas-preview figcaption { color: var(--muted); font-size: .75rem; line-height: 1.6; margin-top: 14px; }
  .home-atlas-preview figcaption strong { color: var(--text); font-weight: 500; }
  @media (min-width: 780px) { .home-atlas-stage { aspect-ratio: 3 / 2; } }
  @media (max-width: 779px) { .home-atlas-preview { max-width: 480px; justify-self: center; } }
</style>
