---
import { getCollection } from 'astro:content';
import ExternalLink from '../components/ExternalLink.astro';
import { experience, profile, roleFit, stackGroups } from '../data/content.js';
import EditorialLayout from '../layouts/EditorialLayout.astro';

const caseStudies = (await getCollection('caseStudies')).sort((left, right) => left.data.order - right.data.order);
const legacyAliases = {
  cnesdata: ['case-cnesdata'],
  limnopulse: ['case-aquafarm'],
  infrastructure: ['case-esus-pec-bootstrap', 'case-infra-ansible', 'case-packer-proxmox-templates']
};
---

<EditorialLayout currentPath="/">
  <section class="hero section" id="top" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-content">
        <p class="eyebrow">Software &amp; Data Engineer · Brazil, UTC-3</p>
        <h1 id="hero-title">I build data pipelines, APIs and automation that make operations more reliable.</h1>
        <p class="hero-lede">
          I turn data-heavy and operational problems into explicit contracts, maintainable services and repeatable workflows.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button" href="#projects">View selected work</a>
          <a class="button button-secondary" href="/resume/">View resume</a>
          <a class="button button-ghost" href="#contact">Contact me</a>
        </div>
      </div>

      <aside class="hero-visual" aria-label="Professional portrait and availability">
        <figure class="portrait-card">
          <picture>
            <source media="(min-width: 780px)" srcset="/assets/images/vinicius-hero-desktop.avif" type="image/avif" />
            <source media="(min-width: 780px)" srcset="/assets/images/vinicius-hero-desktop.webp" type="image/webp" />
            <source srcset="/assets/images/vinicius-portrait-mobile.avif" type="image/avif" />
            <source srcset="/assets/images/vinicius-portrait-mobile.webp" type="image/webp" />
            <img
              src="/assets/images/vinicius-portrait-mobile.jpg"
              alt="Professional portrait of Vinicius Santana"
              width="1600"
              height="900"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
          <figcaption class="availability-card">
            <span class="status-dot" aria-hidden="true"></span>
            {profile.location} · {profile.availability}
          </figcaption>
        </figure>
      </aside>
    </div>
  </section>

  <section class="section section-muted" id="projects" aria-labelledby="projects-title">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2 id="projects-title">Three systems, with evidence and current boundaries made explicit.</h2>
        <p>Each case study separates implemented work, documented direction and limitations.</p>
      </div>
      <div class="project-grid">
        {caseStudies.map(({ data: caseStudy }) => (
          <article class="project-card" id={legacyAliases[caseStudy.id][0]}>
            {legacyAliases[caseStudy.id].slice(1).map((alias) => <span class="legacy-anchor" id={alias} aria-hidden="true"></span>)}
            <p class="project-eyebrow">{caseStudy.eyebrow}</p>
            <h3>{caseStudy.title}</h3>
            <p>{caseStudy.summary}</p>
            <ul class="tech-list" aria-label={`${caseStudy.title} technologies`}>
              {caseStudy.technologies.map((technology) => <li>{technology}</li>)}
            </ul>
            <div class="project-actions">
              <a class="text-link" href={`/work/${caseStudy.id}/`}>Read case study</a>
            </div>
          </article>
        ))}
      </div>
      <p class="section-action"><a class="button button-secondary" href="/work/">Browse all selected work</a></p>
    </div>
  </section>

  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="shell contact-card">
      <div>
        <p class="eyebrow">Resume &amp; contact</p>
        <h2 id="contact-title">A quick path to the practical details.</h2>
        <p>I’m open to remote Software Engineering, Data Engineering and platform-focused conversations.</p>
      </div>
      <div class="contact-actions" aria-label="Resume and contact links">
        <a class="button" href={profile.mailto}>Email {profile.email}</a>
        <a class="button button-secondary" href="/resume/">View resume</a>
        <a class="button button-ghost" href={profile.resume} download>Download resume PDF</a>
        <ExternalLink class="button button-ghost" href={profile.linkedin} ariaLabel="Open Vinicius Santana on LinkedIn">
          LinkedIn
        </ExternalLink>
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div class="about-copy">
        <p class="eyebrow">About</p>
        <h2 id="about-title">I work where data quality, backend systems and operations meet.</h2>
        <p>
          I’m Vinicius Santana, a software and data engineer based in Brazil. I replace fragile manual routines with
          observable, repeatable software and documentation that keeps the operational context visible.
        </p>
        <p><a class="text-link" href="/about/">More about my experience and working style</a></p>
      </div>
      <div class="role-fit-cards" aria-label="Areas of practice">
        {roleFit.map((item) => (
          <article class="role-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted" id="experience" aria-labelledby="experience-title">
    <div class="shell experience-grid">
      <div class="section-heading sticky-heading">
        <p class="eyebrow">Experience</p>
        <h2 id="experience-title">Public-health data and software in an operational setting.</h2>
        <p>{experience.summary}</p>
      </div>
      <article class="timeline-card">
        <div class="timeline-meta"><span>{experience.period}</span><span>{experience.organization}</span></div>
        <h3>{experience.role}</h3>
        <ul class="check-list">{experience.highlights.map((item) => <li>{item}</li>)}</ul>
      </article>
    </div>
  </section>

  <section class="section" id="stack" aria-labelledby="stack-title">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Stack</p>
        <h2 id="stack-title">Tools used across backend, data and operations work.</h2>
      </div>
      <div class="stack-grid">
        {stackGroups.map((group) => (
          <article class="stack-card"><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>
        ))}
      </div>
    </div>
  </section>
</EditorialLayout>
