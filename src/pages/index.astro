---
import ExternalLink from '../components/ExternalLink.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
  caseNotes,
  experience,
  heroChips,
  impactMetrics,
  profile,
  projects,
  roleFit,
  stackGroups
} from '../data/content.js';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <section class="hero section" id="top" aria-labelledby="hero-title">
      <div class="shell hero-grid">
        <div class="hero-content">
          <p class="eyebrow">Open to Data Engineering & Software Engineering roles</p>
          <h1 id="hero-title">I build data pipelines, APIs and automation that make operations more reliable.</h1>
          <p class="hero-lede">
            Brazil-based engineer focused on PostgreSQL, Python, FastAPI, Go and DevOps practices, with hands-on work in
            public-health data reconciliation, backend services and operational tooling.
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button" href={profile.mailto}>Contact me</a>
            <a class="button button-secondary" href="#projects">View projects</a>
            <a class="button button-ghost" href={profile.resume} download>Download resume</a>
          </div>
          <ul class="chip-list" aria-label="Core technologies and domains">
            {heroChips.map((chip) => <li>{chip}</li>)}
          </ul>
        </div>

        <aside class="hero-visual" aria-label="Professional portrait and availability">
          <figure class="portrait-card">
            <picture>
              <source media="(min-width: 780px)" srcset="/assets/images/vinicius-hero-desktop.avif" type="image/avif" />
              <source media="(min-width: 780px)" srcset="/assets/images/vinicius-hero-desktop.webp" type="image/webp" />
              <source srcset="/assets/images/vinicius-portrait-mobile.avif" type="image/avif" />
              <source srcset="/assets/images/vinicius-portrait-mobile.webp" type="image/webp" />
              <img
                src="/assets/images/vinicius-portrait-mobile.jpg"
                alt="Professional portrait of Vinicius Santana"
                width="1600"
                height="900"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
            <figcaption class="availability-card">
              <span class="status-dot" aria-hidden="true"></span>
              {profile.location} · {profile.availability}
            </figcaption>
          </figure>
        </aside>
      </div>
    </section>

    <section class="role-fit section-tight" aria-labelledby="role-fit-title">
      <div class="shell role-fit-grid">
        <div class="role-fit-heading">
          <p class="eyebrow">Recruiter summary</p>
          <h2 id="role-fit-title">Clear fit for data-heavy product, backend and operations teams.</h2>
        </div>
        <div class="role-fit-cards">
          {roleFit.map((item) => (
            <article class="role-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="impact section-tight" aria-labelledby="impact-title">
      <div class="shell">
        <div class="section-heading section-heading-inline">
          <p class="eyebrow">Measured work</p>
          <h2 id="impact-title">Evidence of practical impact, not template claims.</h2>
        </div>
        <div class="impact-grid">
          {impactMetrics.map((metric) => (
            <article class="metric-card">
              <strong>{metric.value}</strong>
              <h3>{metric.label}</h3>
              <p>{metric.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-title">
      <div class="shell about-grid">
        <div class="about-copy">
          <p class="eyebrow">About</p>
          <h2 id="about-title">I work where data quality, backend systems and operations meet.</h2>
          <p>
            I’m Vinicius Santana, a Data Engineer and Software Engineer based in Brazil. My work is about replacing fragile
            manual routines with software that is observable, repeatable and easier to maintain.
          </p>
          <p>
            The strongest examples are in public-health operations: reconciliation pipelines, validation rules, backend APIs,
            scripts, runbooks and infrastructure workflows that keep reporting, billing and operational data under control.
          </p>
          <div class="availability-note" role="note">
            <strong>{profile.location}.</strong> Available for remote opportunities and technical interviews.
          </div>
        </div>
        <figure class="about-image">
          <picture>
            <source srcset="/assets/images/vinicius-about.avif" type="image/avif" />
            <source srcset="/assets/images/vinicius-about.webp" type="image/webp" />
            <img
              src="/assets/images/vinicius-about.jpg"
              alt="Professional portrait of Vinicius Santana in a work-focused setting"
              width="900"
              height="1125"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
    </section>

    <section class="section section-muted" id="experience" aria-labelledby="experience-title">
      <div class="shell experience-grid">
        <div class="section-heading sticky-heading">
          <p class="eyebrow">Experience</p>
          <h2 id="experience-title">Public-health data and software work in production-like operational contexts.</h2>
          <p>{experience.summary}</p>
        </div>
        <article class="timeline-card">
          <div class="timeline-meta">
            <span>{experience.period}</span>
            <span>{experience.organization}</span>
          </div>
          <h3>{experience.role}</h3>
          <ul class="check-list">
            {experience.highlights.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Featured projects</p>
          <h2 id="projects-title">Concrete technical work with visible scope, constraints and tradeoffs.</h2>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <p class="project-eyebrow">{project.eyebrow}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <ul class="proof-list" aria-label={`${project.title} proof points`}>
                {project.proof.map((item) => <li>{item}</li>)}
              </ul>
              <ul class="tech-list" aria-label={`${project.title} stack`}>
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>
              <div class="project-actions">
                {project.links.map((link) => link.external ? (
                  <ExternalLink class="text-link" href={link.href}>{link.label}</ExternalLink>
                ) : (
                  <a class="text-link" href={link.href}>{link.label}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="case-notes-title">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Technical notes</p>
          <h2 id="case-notes-title">How the projects map to engineering judgment.</h2>
        </div>
        <div class="case-grid">
          {caseNotes.map((note) => (
            <article class="case-card" id={note.id} tabindex="-1">
              <h3>{note.title}</h3>
              <p class="case-context">{note.context}</p>
              <ul class="check-list compact">
                {note.approach.map((item) => <li>{item}</li>)}
              </ul>
              <p class="case-outcome">{note.outcome}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="stack" aria-labelledby="stack-title">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Stack</p>
          <h2 id="stack-title">Tools I use to move from raw data and operational needs to maintainable software.</h2>
        </div>
        <div class="stack-grid">
          {stackGroups.map((group) => (
            <article class="stack-card">
              <h3>{group.title}</h3>
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section contact-section" id="contact" aria-labelledby="contact-title">
      <div class="shell contact-card">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 id="contact-title">Let’s build reliable systems.</h2>
          <p>
            I’m open to conversations about Data Engineering, Software Engineering, backend APIs, public-health systems,
            data platforms and DevOps-enabled products.
          </p>
        </div>
        <div class="contact-actions" aria-label="Contact links">
          <a class="button" href={profile.mailto}>Email {profile.email}</a>
          <ExternalLink class="button button-secondary" href={profile.linkedin} ariaLabel="Open Vinicius Santana on LinkedIn">
            LinkedIn
          </ExternalLink>
          <ExternalLink class="button button-ghost" href={profile.github} ariaLabel="Open Vinicius Santana on GitHub">
            GitHub
          </ExternalLink>
          <a class="button button-ghost" href={profile.resume} download>Download resume</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
