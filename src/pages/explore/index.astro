---
import { getCollection } from 'astro:content';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { districtIds } from '../../features/explorer/districts.ts';
import { overview } from '../../content/scenes/index.ts';
import { projectToPoster } from '../../features/explorer/observatory-projection.ts';
import '../../features/explorer/explorer.css';
import '../../features/explorer/observatory.css';
const { poster, layouts } = overview;
const entries = await getCollection('caseStudies');
const projects = districtIds.map(id => entries.find(entry => entry.id === id)!.data);
const positionStyle = (desktop: { x: number; y: number }, mobile: { x: number; y: number }) => `--desktop-x:${desktop.x}%;--desktop-y:${desktop.y}%;--mobile-x:${mobile.x}%;--mobile-y:${mobile.y}%;`;
---
<EditorialLayout title="Systems Observatory — Vinicius Santana" description="Explore three engineering projects around a central systems hub." canonicalPath="/explore/">
  <div class="shell explorer" data-observatory data-scene-state="fallback">
    <header class="explorer-heading">
      <p class="eyebrow">Systems Observatory</p>
      <h1>Explore the systems.</h1>
      <p>Three projects. Connected engineering perspectives. Select a project to preview its work, technologies and system context.</p>
      <p class="explorer-note">Illustrative views, not live systems or production dashboards.</p>
    </header>
    <div class="observatory-stage">
      <nav class="observatory-map" aria-label="Select a project">
        <picture>
          <source media="(max-width: 700px)" srcset={poster.mobile.src} width={poster.mobile.width} height={poster.mobile.height} />
          <img src={poster.desktop.src} alt={poster.desktop.alt} width={poster.desktop.width} height={poster.desktop.height} fetchpriority="high" />
        </picture>
        <span class="observatory-hub" style={positionStyle(projectToPoster(layouts.desktop.hubPosition, layouts.desktop.camera), projectToPoster(layouts.mobile.hubPosition, layouts.mobile.camera))}>Systems hub</span>
        {projects.map((project, index) => <a
          class={`district-link district-link-${project.id}`}
          href={`#district-${project.id}`}
          data-district-link={project.id}
          aria-controls={`district-${project.id}`}
          style={positionStyle(projectToPoster(layouts.desktop.placements[project.id], layouts.desktop.camera), projectToPoster(layouts.mobile.placements[project.id], layouts.mobile.camera))}
        ><span class="district-number" aria-hidden="true">0{index + 1}</span><span>{project.title}</span></a>)}
      </nav>
      <div class="district-details">
        {projects.map(project => <article id={`district-${project.id}`} class={`explorer-area area-${project.id}`} data-district-detail={project.id} data-selected="false" aria-labelledby={`district-title-${project.id}`}>
          <a class="district-panel-close" href="/explore/" data-district-close aria-label={`Close ${project.title} panel`}><span aria-hidden="true">×</span></a>
          <p class="eyebrow">Project</p>
          <h2 id={`district-title-${project.id}`}>{project.title}</h2>
          <p>{project.summary}</p>
          <ul class="district-technologies" aria-label="Main technologies">
            {project.technologies.slice(0, 4).map(technology => <li>{technology}</li>)}
          </ul>
          <a class="button button-primary" href={`/explore/${project.id}/`}>Explore {project.title}</a>
        </article>)}
      </div>
    </div>
    <div class="observatory-controls" data-scene-controls hidden aria-label="3D view controls" role="group">
      <button type="button" data-scene-action="zoom-in">Zoom in</button>
      <button type="button" data-scene-action="zoom-out">Zoom out</button>
      <button type="button" data-scene-action="reset">Reset view</button>
      <button type="button" data-scene-action="fallback">View 2D</button>
    </div>
    <p class="observatory-instruction">Choose a project on the map to open its preview.</p>
  </div>
</EditorialLayout>
<script>
  import '../../features/explorer/observatory-client.ts';
</script>
