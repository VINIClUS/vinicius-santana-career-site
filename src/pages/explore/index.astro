---
import { getCollection } from 'astro:content';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { districtIds, districtRegistry, type DistrictId } from '../../features/explorer/districts.ts';
import { overview } from '../../content/scenes/index.ts';
import { projectToPoster } from '../../features/explorer/observatory-projection.ts';
import { isPublicRepository } from '../../content/publicRepository.js';
import '../../features/explorer/explorer.css';
import '../../features/explorer/observatory.css';
const { poster, layouts } = overview;
const entries = await getCollection('caseStudies');
const projects = districtIds.map(id => entries.find(entry => entry.id === id)!.data);
const selectorProjects = ['cnesdata', 'infrastructure', 'limnopulse', 'esusdata'].map(id => projects.find(project => project.id === id)!);
const accessProjects = ['cnesdata', 'esusdata', 'infrastructure', 'limnopulse'].map(id => projects.find(project => project.id === id)!);
const positionStyle = (desktop: { x: number; y: number }, mobile: { x: number; y: number }) => `--desktop-x:${desktop.x}%;--desktop-y:${desktop.y}%;--mobile-x:${mobile.x}%;--mobile-y:${mobile.y}%;`;
---
<EditorialLayout title="Systems Atlas — Vinicius Santana" description="Explore CnesData, LimnoPulse, Infrastructure and Esusdata: four projects spanning data platforms, telemetry, systems operations and primary care." canonicalPath="/explore/" currentPath="/explore/" observatory>
  <div class="shell explorer" data-observatory data-scene-state="fallback">
    <header class="explorer-heading">
      <p class="eyebrow">Systems Atlas</p>
      <h1>Systems Atlas.</h1>
      <p>Four projects. From data contracts and primary-care indicators to environmental telemetry and repeatable infrastructure. Choose a project to explore its architecture.</p>
      <p class="explorer-note">Conceptual portfolio map — not a deployed network.</p>
    </header>
    <nav class="atlas-index" aria-label="Projects at a glance">
      <ol>
        {selectorProjects.map((project, index) => <li class={`atlas-index-item atlas-index-${project.id}`}>
          <a class="atlas-index-select" href={`#district-${project.id}`} data-district-select={project.id} aria-controls={`district-${project.id}`}>
            <span class="district-number" aria-hidden="true">0{index + 1}</span>
            <span class="atlas-index-title">{project.title}</span>
            <span class="atlas-index-area">{districtRegistry[project.id as DistrictId].area} · {districtRegistry[project.id as DistrictId].stack.join(', ')}</span>
          </a>
          <a class="atlas-index-case" href={`/explore/${project.id}/`} aria-label={`Case study: ${project.title}`}>Case study →</a>
        </li>)}
      </ol>
    </nav>
    <div class="observatory-stage">
      <nav class="observatory-map" aria-label="Select a project">
        <picture>
          <source media="(max-width: 700px)" srcset={poster.mobile.src} width={poster.mobile.width} height={poster.mobile.height} />
          <img src={poster.desktop.src} alt={poster.desktop.alt} width={poster.desktop.width} height={poster.desktop.height} fetchpriority="high" />
        </picture>
        {(['desktop', 'mobile'] as const).map(name => <svg class={`observatory-regions region-layout-${name}`} data-region-layout={name} viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          {districtIds.map(id => {
            const points = layouts[name].regionOutlines[id].map(point => {
              const { x, y } = projectToPoster(point, layouts[name].camera);
              return `${x * 10},${y * 10}`;
            }).join(' ');
            return <g data-region={id}>
              <polygon class="region-selection" points={points} data-region-points={id} vector-effect="non-scaling-stroke" />
              <polygon class="region-highlight" points={points} data-region-points={id} vector-effect="non-scaling-stroke" />
            </g>;
          })}
        </svg>)}
        <span class="observatory-hub" aria-hidden="true" style={positionStyle(projectToPoster(layouts.desktop.hubPosition, layouts.desktop.camera), projectToPoster(layouts.mobile.hubPosition, layouts.mobile.camera))}>00</span>
        <div class="district-selectors">
          <p class="district-selectors-title eyebrow" aria-hidden="true">Projects</p>
          {selectorProjects.map((project, index) => <a
            class={`district-link district-link-${project.id}`}
            href={`#district-${project.id}`}
            data-district-link={project.id}
            aria-controls={`district-${project.id}`}
            style={positionStyle(projectToPoster(layouts.desktop.labelPositions[project.id], layouts.desktop.camera), projectToPoster(layouts.mobile.labelPositions[project.id], layouts.mobile.camera))}
          ><span class="district-number" aria-hidden="true">0{index + 1}</span><span>{project.title}</span></a>)}
        </div>
      </nav>
      <div class="district-details">
        {projects.map(project => <article id={`district-${project.id}`} class={`explorer-area area-${project.id}`} data-district-detail={project.id} data-selected="false" aria-labelledby={`district-title-${project.id}`}>
          <a class="district-panel-close" href="/explore/" data-district-close aria-label={`Close ${project.title} panel`}><span aria-hidden="true">×</span></a>
          <p class="eyebrow">Project</p>
          <h2 id={`district-title-${project.id}`}>{project.title}</h2>
          <p>{project.summary}</p>
          <ul class="district-technologies" aria-label="Main technologies">
            {project.technologies.slice(0, 4).map(technology => <li>{technology}</li>)}
          </ul>
          <p class="district-status">Built: {project.preview.built}{project.preview.next && ` · Next: ${project.preview.next}`}</p>
          <div class="district-actions">
            <a class="button button-primary" href={`/explore/${project.id}/`} aria-label={`${project.title} case study`}>Case study</a>
            <ExternalLink href={project.evidence.find(isPublicRepository)!.url} class="button button-secondary" ariaLabel={`${project.title} code on GitHub`}>Code</ExternalLink>
          </div>
        </article>)}
      </div>
    </div>
    <div class="observatory-controls" data-scene-controls hidden aria-label="3D view controls" role="group">
      <button type="button" data-scene-action="zoom-in" disabled>Zoom in</button>
      <button type="button" data-scene-action="zoom-out" disabled>Zoom out</button>
      <button type="button" data-scene-action="reset" disabled>Reset view</button>
      <button type="button" data-scene-action="fallback">View 2D</button>
    </div>
    <p class="observatory-instruction">Choose a project on the map to open its preview. Every project stays available in both 2D and 3D.</p>
    <section class="project-access" aria-labelledby="project-access-title">
      <h2 id="project-access-title">Go straight to a project</h2>
      <div class="project-access-grid">
        {accessProjects.map(project => <article class={`project-card project-card-${project.id}`} data-project-card={project.id} aria-labelledby={`project-card-title-${project.id}`}>
          <p class="eyebrow">{project.eyebrow}</p>
          <h3 id={`project-card-title-${project.id}`}>{project.title}</h3>
          <ul class="project-card-stack" aria-label="Stack">
            {project.technologies.slice(0, 5).map(technology => <li>{technology}</li>)}
          </ul>
          <dl>
            <dt>Built</dt>
            <dd>{project.summary}</dd>
            <dt>Status</dt>
            <dd>{project.currentStatus}</dd>
            <dt>Public proof</dt>
            <dd><ExternalLink href={project.evidence[0].url} class="project-card-proof">{project.evidence[0].label}</ExternalLink></dd>
          </dl>
          <a class="button button-primary" href={`/explore/${project.id}/`}>Open {project.title}</a>
        </article>)}
      </div>
    </section>
  </div>
</EditorialLayout>
<script>
  import '../../features/explorer/observatory-client.ts';
</script>
