---
import EditorialLayout from '../layouts/EditorialLayout.astro';
---

<EditorialLayout
  title="Privacy — Vinicius Santana"
  description="Privacy information for Vinicius Santana's static career site."
  canonicalPath="/privacy/"
>
  <header class="page-hero shell">
    <p class="eyebrow">Privacy</p>
    <h1>A small static site with a small data footprint.</h1>
  </header>
  <section class="section section-muted">
    <div class="shell editorial-copy">
      <h2>What this site collects</h2>
      <p>This site does not use analytics and does not include a form.</p>
      <p>It does not provide an account and does not set first-party cookies.</p>
      <p>
        Contact links open your email client or third-party sites such as GitHub and LinkedIn. Those services apply their
        own privacy practices after you choose to visit them.
      </p>
    </div>
  </section>
</EditorialLayout>
