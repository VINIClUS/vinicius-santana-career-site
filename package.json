{
  "name": "vinicius-santana-career-site",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Static career landing page for Vinicius Santana, built with Astro for GitHub Pages.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "test": "npm run typecheck:simulation && node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck:simulation": "tsc --project tsconfig.simulation.json",
    "smoke": "node tests/static-build.smoke.mjs",
    "preview": "astro preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
