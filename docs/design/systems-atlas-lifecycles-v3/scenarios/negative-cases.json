      },
      "reason": "Fonte nacional obrigatória ainda ausente.",
      "invariant": "CND-I4"
    },
    {
      "id": "CND-N04",
      "scenarioId": "cnesdata-end-to-end",
      "fromCheckpoint": "cnesdata-end-to-end-11",
      "commands": [
