        }
      ],
      "expectedSubset": {
        "rawObjects": 1,
        "currentVersion": "v-demo-00"
      },
      "reason": "Replay preserva um objeto.",
      "invariant": "CND-I1"
    },
    {
      "id": "CND-N02",
      "scenarioId": "cnesdata-end-to-end",
      "fromCheckpoint": "cnesdata-end-to-end-05",
      "commands": [
        {
          "type": "PUT_RAW_OBJECT",
          "snapshotId": "snap-local-01",
          "fence": 1,
          "contentVariant": "different"
        }
      ],
      "expectedSubset": {
        "rawObjects": 1,
        "currentVersion": "v-demo-00"
      },
      "reason": "Conflito não sobrescreve bytes originais; verificar hash também no teste de domínio.",
      "invariant": "CND-I1"
    },
    {
      "id": "CND-N03",
      "scenarioId": "cnesdata-end-to-end",
      "fromCheckpoint": "cnesdata-end-to-end-07",
