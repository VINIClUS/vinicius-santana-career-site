      },
      "reason": "Ausência de dados não é recuperação.",
      "invariant": "LP-I1"
    },
    {
      "id": "LP-N08",
      "scenarioId": "limnopulse-end-to-end",
      "fromCheckpoint": "limnopulse-end-to-end-14",
      "commands": [
        {
