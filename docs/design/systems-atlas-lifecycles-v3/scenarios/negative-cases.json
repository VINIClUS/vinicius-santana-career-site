      "invariant": "CND-I7"
    },
    {
      "id": "CND-N06",
      "scenarioId": "cnesdata-end-to-end",
      "fromCheckpoint": "cnesdata-end-to-end-15",
      "commands": [
        {
          "type": "PUBLISH_CURRENT",
