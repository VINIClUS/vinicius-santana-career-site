      },
      "reason": "Duplicata já confirmada não chama provedor de novo.",
      "invariant": "LP-I5"
    },
    {
      "id": "CND-N01",
      "scenarioId": "cnesdata-end-to-end",
      "fromCheckpoint": "cnesdata-end-to-end-05",
      "commands": [
        {
