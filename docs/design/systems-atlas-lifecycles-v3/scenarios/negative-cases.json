    {
      "id": "CND-N08",
      "scenarioId": "cnesdata-end-to-end",
      "fromCheckpoint": "cnesdata-end-to-end-07",
      "commands": [
        {
          "type": "REQUEST_EXTRACTION",
          "source": "CNES_LOCAL",
          "competencia": "2026-07",
          "snapshotMode": "DELTA"
        },
        {
          "type": "CLAIM_JOB",
          "agentId": "agent-demo-01"
        },
        {
          "type": "PUT_RAW_OBJECT",
          "snapshotId": "snap-delta-gap",
          "fence": "current"
        },
        {
          "type": "REGISTER_DELTA_MANIFEST",
          "baseSnapshotId": "snap-local-01",
          "sequence": 3,
          "previousManifestHash": "canonical-head-from-state"
        },
        {
          "type": "ADVANCE_CLOCK",
          "ticks": 30
        }
      ],
      "expectedSubset": {
        "job": "FAILED_FINAL",
        "currentVersion": "v-demo-00",
        "replacementFullJobCreated": false
      },
      "reason": "Validar um DELTA autenticado cuja sequência pula 2; job falha final e resync não agenda FULL. Valores current/canonical-head-from-state são resolvidos pelo harness, não campos enviados ao backend.",
      "invariant": "CND-I8"
    },
    {
      "id": "CND-N09",
      "scenarioId": "cnesdata-end-to-end",
      "fromCheckpoint": "cnesdata-end-to-end-07",
