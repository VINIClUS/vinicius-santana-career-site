    },
    {
      "id": "LP-N05",
      "scenarioId": "limnopulse-end-to-end",
      "fromCheckpoint": "limnopulse-end-to-end-10",
      "commands": [
        {
          "type": "PROVIDER_RESULT",
          "channel": "telegram",
          "kind": "opening",
          "result": "unknown"
        },
        {
          "type": "ADVANCE_CLOCK",
          "ticks": 100
        }
      ],
      "expectedSubset": {
        "telegram": "unknown",
        "telegramAttempts": 1
      },
      "reason": "Confirmação ambígua não gera reenvio automático.",
      "invariant": "LP-I6"
    },
    {
      "id": "LP-N06",
      "scenarioId": "limnopulse-end-to-end",
      "fromCheckpoint": "limnopulse-end-to-end-17",
      "commands": [
        {
