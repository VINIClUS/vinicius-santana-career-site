      "expectedSubset": {
        "nationalAccepted": false,
        "run": "WAITING_INPUTS",
        "currentVersion": "v-demo-00"
      },
      "reason": "Não trocar para mês anterior.",
      "invariant": "CND-I10"
    }
  ]
