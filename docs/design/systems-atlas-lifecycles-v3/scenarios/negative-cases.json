      "invariant": "LP-I7"
    },
    {
      "id": "LP-N03",
      "scenarioId": "limnopulse-end-to-end",
      "fromCheckpoint": "limnopulse-end-to-end-06",
      "commands": [
        {
          "type": "EVALUATE",
