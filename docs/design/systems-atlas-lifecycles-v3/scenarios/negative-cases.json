{
  "schemaVersion": "2.0",
  "description": "Acceptance cases for the future reducers. Not executed by the reference viewer. expectedSubset is a deep partial projection. Commands not in guided tours remain mandatory failure controls.",
  "cases": [
    {
      "id": "INF-N01",
      "scenarioId": "infra-exhaustion-recovery",
      "fromCheckpoint": "infra-exhaustion-recovery-00",
      "commands": [
        {
          "type": "FAIL_NODE",
          "nodeId": "node-03"
        }
      ],
      "expectedSubset": {
        "nodeId": "node-02",
        "workloadStatus": "running"
      },
      "reason": "Falha de host não proprietário não desloca a instância.",
      "invariant": "INF-I1"
    },
    {
      "id": "INF-N02",
      "scenarioId": "infra-exhaustion-recovery",
      "fromCheckpoint": "infra-exhaustion-recovery-01",
      "commands": [
        {
          "type": "RECONCILE"
        }
      ],
      "expectedSubset": {
        "nodeId": null,
        "unsafeOwner": "node-02",
        "clientAvailable": false
      },
      "reason": "Não iniciar antes do fence.",
      "invariant": "INF-I5"
    },
    {
      "id": "INF-N03",
      "scenarioId": "infra-exhaustion-recovery",
      "fromCheckpoint": "infra-exhaustion-recovery-11",
      "commands": [
        {
          "type": "RECONCILE"
        }
      ],
      "expectedSubset": {
        "nodeId": null,
        "workloadStatus": "pending"
      },
      "reason": "Zero workers mantém intenção pendente.",
      "invariant": "INF-I3"
    },
    {
      "id": "INF-N04",
      "scenarioId": "infra-exhaustion-recovery",
      "fromCheckpoint": "infra-exhaustion-recovery-11",
      "commands": [
        {
          "type": "SET_DESIRED",
          "value": "stopped"
        },
        {
          "type": "RESTORE_NODE",
          "nodeId": "node-02"
        },
        {
          "type": "NODE_READY",
          "nodeId": "node-02"
        },
        {
          "type": "ADVANCE_CLOCK",
          "ticks": 3
        }
      ],
      "expectedSubset": {
        "desired": "stopped",
        "nodeId": null,
        "workloadStatus": "stopped"
      },
      "reason": "Retorno não desfaz stop intencional.",
      "invariant": "INF-I2"
    },
    {
      "id": "INF-N05",
      "scenarioId": "infra-quorum-recovery",
      "fromCheckpoint": "infra-quorum-recovery-09",
      "commands": [
        {
          "type": "RECONCILE"
        }
      ],
      "expectedSubset": {
        "quorum": false,
        "nodeId": null,
        "clientAvailable": false
      },
      "reason": "1/3 não autoriza novo start.",
      "invariant": "INF-I4"
    },
    {
      "id": "INF-N06",
      "scenarioId": "infra-quorum-recovery",
      "fromCheckpoint": "infra-quorum-recovery-11",
      "commands": [
        {
          "type": "RECONCILE"
        }
      ],
      "expectedSubset": {
        "quorum": true,
        "storageReady": false,
        "nodeId": null
      },
      "reason": "Quorum sozinho não libera storage.",
      "invariant": "INF-I2"
    },
    {
      "id": "INF-N07",
      "scenarioId": "infra-exhaustion-recovery",
      "fromCheckpoint": "infra-exhaustion-recovery-03",
      "commands": [
        {
          "type": "FAIL_NODE",
          "nodeId": "node-01"
        },
        {
          "type": "WORKLOAD_HEALTHY",
          "generation": 2
        }
      ],
      "expectedSubset": {
        "nodeId": null,
        "clientAvailable": false
      },
      "reason": "Healthcheck tardio não ressuscita instância em host morto.",
      "invariant": "INF-I8"
    },
    {
      "id": "INF-N08",
      "scenarioId": "infra-provision-scale",
      "fromCheckpoint": "infra-provision-scale-00",
      "commands": [
        {
          "type": "RESERVE_WORKERS",
          "ids": [
            "worker-X1",
            "worker-X2",
            "worker-X3",
            "worker-X4"
          ],
          "requestId": "req-over-capacity"
        }
      ],
      "expectedSubset": {
        "usedSlots": 1,
        "reservedSlots": 0,
        "physicalHosts": 3
      },
      "reason": "Rejeitar reserva que excede quatro slots.",
      "invariant": "INF-I6"
    },
    {
      "id": "INF-N09",
      "scenarioId": "infra-provision-scale",
      "fromCheckpoint": "infra-provision-scale-04",
      "commands": [
        {
          "type": "RESERVE_WORKERS",
          "ids": [
            "worker-02",
            "worker-03"
          ],
          "requestId": "req-scale-01"
        }
      ],
      "expectedSubset": {
        "reservedSlots": 2,
        "usedSlots": 1
      },
      "reason": "Pedido idêntico não reserva outra vez.",
      "invariant": "INF-I6"
    },
    {
      "id": "INF-N10",
      "scenarioId": "infra-provision-scale",
      "fromCheckpoint": "infra-provision-scale-13",
      "commands": [
        {
          "type": "STOP_REPLICAS",
          "ids": [
            "replica-02",
            "replica-03"
          ]
        }
      ],
      "expectedSubset": {
        "inFlight": 2,
        "replicas": {
          "replica-02": "draining",
          "replica-03": "draining"
        }
      },
      "reason": "Não parar antes de terminar requisições em voo.",
      "invariant": "INF-I8"
    },
    {
      "id": "LP-N01",
      "scenarioId": "limnopulse-end-to-end",
      "fromCheckpoint": "limnopulse-end-to-end-04",
      "commands": [
