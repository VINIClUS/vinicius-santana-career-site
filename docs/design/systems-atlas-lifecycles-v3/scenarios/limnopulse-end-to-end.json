{
  "schemaVersion": "2.0",
  "id": "limnopulse-end-to-end",
  "project": "limnopulse",
  "scene": "limnopulse",
  "title": "Da água à ação — e à recuperação.",
  "subtitle": "Acompanhe um incidente até o destinatário, sem confundir envio e leitura.",
  "profile": "documented-software-and-mock-ui",
  "evidenceStatus": "illustrative",
