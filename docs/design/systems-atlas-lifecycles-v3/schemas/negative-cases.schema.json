{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenarioId",
          "fromCheckpoint",
          "commands",
          "expectedSubset",
          "reason",
          "invariant"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scenarioId": {
            "type": "string"
          },
          "fromCheckpoint": {
            "type": "string"
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type"
              ]
            }
          },
          "expectedSubset": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          },
          "invariant": {
            "type": "string"
          }
        }
      }
    }
  }
}
